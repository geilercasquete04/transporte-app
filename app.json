{
  "expo": {
    "name": "transporte-app",
    "slug": "transporte-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "transporteapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a la ubicación para mostrar tu posición en el mapa de rutas del camión de la basura.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta app necesita acceso a la ubicación para rastrear las rutas del camión de la basura."
      },
      "config": {
        "googleMapsApiKey": "TU_API_KEY_AQUI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "TU_API_KEY_AQUI"
        }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.transporteapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3c293355-7407-48b7-bb52-3032a08b523b"
      }
    },
    "owner": "jameva"
  }
}
